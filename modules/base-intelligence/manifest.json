{
  "id": "base-intelligence",
  "name": "Player Intelligence",
  "version": "0.6.0",
  "apiVersion": "1.0.0",
  "author": "ProfessorSr",
  "lastUpdated": "2026-08-14",
  "description": "Player overview, achievements, and intelligence for every owned base.",
  "dependencies": [],
  "permissions": ["events", "game", "hooks", "settings", "windows"],
  "settings": {
    "stickerMode": { "type": "string", "default": "compact", "enum": ["compact", "super-compact"] },
    "stickerPinned": { "type": "boolean", "default": true },
    "stickerLocked": { "type": "boolean", "default": false },
    "resourceOrder": { "type": "string", "default": "tiberium,crystal,power", "enum": ["tiberium,crystal,power", "power,tiberium,crystal", "crystal,tiberium,power"] },
    "showRegionDetails": { "type": "boolean", "default": true },
    "showOnlineColors": { "type": "boolean", "default": true }
  }
}

{
  "id": "repair-manager",
  "name": "Repair & Collection Manager",
  "version": "0.2.0",
  "apiVersion": "1.0.0",
  "author": "ProfessorSr",
  "lastUpdated": "2026-07-20",
  "description": "Automatic and manual repair and resource collection controls for owned bases.",
  "dependencies": [],
  "permissions": [
    "events",
    "game",
    "modules",
    "notifications",
    "settings",
    "windows"
  ],
  "settings": {
    "autoCollect": { "type": "boolean", "default": false },
    "autoRepairBuildings": { "type": "boolean", "default": false },
    "autoRepairOffense": { "type": "boolean", "default": false },
    "autoRepairDefense": { "type": "boolean", "default": false },
    "repairPriority": {
      "type": "string",
      "default": "defense-first",
      "enum": ["defense-first", "production-first", "core-first"]
    },
    "intervalSeconds": { "type": "number", "default": 15, "min": 5, "max": 300 }
  }
}

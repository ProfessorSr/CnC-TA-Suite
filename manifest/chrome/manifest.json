{
  "manifest_version": 3,
  "name": "CnC-TA-Suite",
  "version": "1.1.0",
  "description": "A modular command center and planning suite for Command & Conquer: Tiberium Alliances.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.alliances.commandandconquer.com/*",
    "https://*.tiberiumalliances.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.alliances.commandandconquer.com/*",
        "https://*.tiberiumalliances.com/*"
      ],
      "js": [
        "manifest/chrome/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "manifest/chrome/suite.js",
        "manifest/chrome/suite.css",
        "core/**/*.js",
        "modules/**/*.js",
        "modules/**/*.css",
        "assets/**/*"
      ],
      "matches": [
        "https://*.alliances.commandandconquer.com/*",
        "https://*.tiberiumalliances.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "CnC-TA-Suite"
  }
}
